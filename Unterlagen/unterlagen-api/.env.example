# Copy to ".env" and fill in. Load with:  set -a; source .env; set +a
# Then run:  python3 transfer_unterlagen.py --source-case A23WYC --target-case B98ZZ

# --- Source instance (read) ---  needs scopes: unterlagen:dokument:lesen, unterlagen:unterlage:lesen
EUROPACE_SRC_CLIENT_ID=
EUROPACE_SRC_CLIENT_SECRET=

# --- Target instance (write) --- needs scopes: unterlagen:dokument:schreiben, unterlagen:unterlage:lesen
EUROPACE_TGT_CLIENT_ID=
EUROPACE_TGT_CLIENT_SECRET=

# --- Optional overrides (defaults are correct for production Europace) ---
# EUROPACE_TOKEN_URL=https://api.europace.de/auth/token
# EUROPACE_API_BASE=https://api.europace2.de
