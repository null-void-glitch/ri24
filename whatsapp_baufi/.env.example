# Copy to .env and fill in. Do NOT commit .env.

# === Coexistence onboarding (coexistence_server.py + coexistence_onboard.html) ===
# Meta app id (public — injected into the onboarding page).
META_APP_ID=
# Meta app secret (server-side ONLY — used for the OAuth code exchange; never sent to the browser).
META_APP_SECRET=
# Facebook Login for Business "configuration id" set up for WhatsApp Embedded Signup.
META_CONFIG_ID=
# Port for the local onboarding server (default 8080).
PORT=8080

# === Shared ===
# Graph API version (default v25.0).
GRAPH_VERSION=v25.0

# === Self-service fallback only (migrate_number.py) — NOT used for coexistence ===
# Destination WABA you own + a system-user token with whatsapp_business_management.
WABA_ID=
WA_ACCESS_TOKEN=
