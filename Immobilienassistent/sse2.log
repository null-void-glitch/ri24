data: {"result":{"tools":[{"name":"ping","title":"Ping server","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{}},"annotations":{"readOnlyHint":true,"openWorldHint":false,"destructiveHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"search_real_estate","title":"Immobilien suchen","inputSchema":{"type":"object","properties":{"location":{"type":"string","description":"Stadt oder Ort, nach dem gefiltert werden soll"},"maxPrice":{"type":"number","description":"Maximaler akzeptabler Preis für die Immobilie in Euro"},"minZimmer":{"type":"number","description":"Minimale Anzahl der Zimmer. Wenn der Nutzer eine genaue Zimmeranzahl nennt (z.B. '3-Zimmer-Wohnung'), setze minZimmer UND maxZimmer auf denselben Wert."},"maxZimmer":{"type":"number","description":"Maximale Anzahl der Zimmer. Wenn der Nutzer eine genaue Zimmeranzahl nennt (z.B. '3-Zimmer-Wohnung'), setze minZimmer UND maxZimmer auf denselben Wert. Wenn der Nutzer 'mindestens X Zimmer' sagt, setze nur minZimmer. Wenn 'bis zu X Zimmer', setze nur maxZimmer."},"vermarktungsart":{"type":"string","enum":["kauf","miete"],"description":"Kaufen oder Mieten. WICHTIGE DEFAULTS: Wenn der Nutzer nach WOHNUNGEN sucht und NICHT explizit 'kaufen', 'kauf', 'eigentum' oder 'eigentumswohnung' sagt, setze vermarktungsart='miete' (Default: Wohnung = Miete). Wenn der Nutzer nach HÄUSERN sucht und NICHT explizit 'mieten', 'miete' oder 'zur Miete' sagt, setze vermarktungsart='kauf' (Default: Haus = Kauf)."},"objektart":{"type":"string","enum":["wohnung","haus","grundstueck","garage_stellplatz","seniorenwohnen","wohnen_auf_zeit","wg_zimmer","neubau","anlageobjekt","zwangsversteigerung","buero_praxis","halle_produktion","einzelhandel","gastronomie_hotel","gewerbegrundstueck","sonstige_wohnen","sonstige_gewerbe"],"description":"Art der Immobilie gemäss den Suchkategorien von Regionalimmobilien24"},"softFilters":{"type":"array","items":{"type":"string","enum":["balkon","terrasse","garten","aufzug","barrierefrei","gaeste_wc","einbaukueche","badewanne","dusche","fussbodenheizung","kamin","abstellraum","keller","dachboden","moebliert","klimaanlage","stellplatz","garage","tiefgarage","e_ladestation","fahrradraum","oeffentlicher_nv","nahe_bahnhof","autobahnanbindung","haustiere_erlaubt","wg_geeignet","familienfreundlich","seniorenfreundlich","kurzzeitmiete","ruhige_lage","zentrale_lage","naturnahe_lage","innenstadtlage","blick_ins_gruene","suedausrichtung","einkauf_nah","schule_nah","kindergarten_nah","arzt_nah","restaurant_nah","park_nah","spielplatz_nah","neubau","altbau","modernisiert","energieeffizient","hausmeisterservice","erdgeschoss","dachgeschoss","helle_wohnung","hohe_decken","provisionsfrei"]},"description":"Gewünschte Ausstattungsmerkmale und Soft-Filter. Erkenne diese aus der natürlichen Sprache des Nutzers. Beispiele: 'mit Balkon' → ['balkon'], 'haustierfreundlich' → ['haustiere_erlaubt'], 'ruhige Lage mit Aufzug' → ['ruhige_lage', 'aufzug'], 'provisionsfrei' → ['provisionsfrei']. Nutze diese Filter zusätzlich zu den Hauptfiltern location/maxPrice/minZimmer."}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"readOnlyHint":true,"openWorldHint":false,"destructiveHint":false},"execution":{"taskSupport":"forbidden"},"_meta":{"ui":{"resourceUri":"ui://widget/real-estate-board.html"},"openai/outputTemplate":"ui://widget/real-estate-board.html","openai/toolInvocation/invoking":"Sucht Immobilien...","openai/toolInvocation/invoked":"Immobilien gefunden.","ui/resourceUri":"ui://widget/real-estate-board.html"}},{"name":"getExposeData","description":"Liest das Exposé der aktuellen Immobilie anhand der URL des Exposés aus, um detaillierte Informationen wie Preis, Makler und Finanzierungsberater für den Kontext zu laden.","inputSchema":{"type":"object","properties":{"url":{"type":"string","description":"Die vollständige URL der Exposé-Seite der Immobilie, auf die sich die Konversation bezieht."}},"required":["url"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false},"execution":{"taskSupport":"forbidden"}},{"name":"searchNearby","description":"Sucht in der Nähe der Immobilie nach POIs (Schulen, Supermärkte, Ärzte, ÖPNV, etc.) über Google Places und liefert Entfernungen.","inputSchema":{"type":"object","properties":{"adresse":{"type":"string","description":"Die vollständige Adresse der Immobilie aus den Exposé-Daten (z.B. 'Musterstraße 1, 10115 Berlin')."},"typ":{"type":"string","description":"Die Art der gesuchten Einrichtung (z.B. 'Supermarkt', 'Grundschule', 'Apotheke', 'Bushaltestelle')."},"radius":{"type":"number","description":"Der Suchradius um die Immobilie in Metern (Standard: 2000)."}},"required":["adresse","typ"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false},"execution":{"taskSupport":"forbidden"}}]},"jsonrpc":"2.0","id":1}

